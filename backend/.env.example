# ---------------------------------------------------------------------------
# Copy this file to backend/.env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-studio-key

# MongoDB Atlas connection string (free M0 cluster):
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trip-orchestra?retryWrites=true&w=majority
MONGODB_URI=your-mongodb-atlas-connection-string

# Which provider the LLM client uses. "gemini" today; "groq" is a drop-in swap.
LLM_PROVIDER=gemini

# Gemini model. gemini-2.5-flash is on the free tier; gemini-2.0-flash is a fallback.
GEMINI_MODEL=gemini-2.5-flash

# Backend port (the Vite dev proxy points here).
PORT=5000

# Comma-separated allowed origins for CORS in production (Vercel URL goes here).
# Left blank in local dev because the Vite proxy serves the frontend same-origin.
CORS_ORIGIN=
